# ===================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ===================================
# Este archivo es solo una PLANTILLA
# NO subir a GitHub con valores reales

# Base de Datos (Supabase)
DB_HOST=db.xxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu-password-de-supabase

# JWT Secret (generar uno seguro)
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu-jwt-secret-muy-largo-y-aleatorio

# Email (Gmail - usar App Password)
# Obtener en: https://myaccount.google.com/apppasswords
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-app-password-de-16-caracteres

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Frontend URL (actualizar después de desplegar en Vercel)
FRONTEND_URL=https://adopciones-mimascota.vercel.app

# Node Environment
NODE_ENV=production
